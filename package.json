{
  "name": "wa-delivery",
  "version": "2.0.0-alpha.1",
  "description": "Aplicação local para gerenciar campanhas de WhatsApp",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/app.ts",
    "start": "node dist/app.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dudushy/WA-Delivery.git"
  },
  "keywords": ["whatsapp", "baileys", "campaigns"],
  "author": "dudushy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dudushy/WA-Delivery/issues"
  },
  "homepage": "https://github.com/dudushy/WA-Delivery#readme",
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@hapi/boom": "10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "fastify": "5.12.5",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
